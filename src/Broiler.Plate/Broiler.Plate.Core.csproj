<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Plate</RootNamespace>
    <AssemblyName>Broiler.Plate.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\icon-256.png" LogicalName="Broiler.Plate.About.png" />
    <EmbeddedResource Include="..\..\icon-128.png" LogicalName="Broiler.Plate.icon-128.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Plate.Windows" />
    <InternalsVisibleTo Include="Broiler.Plate.Linux" />
    <InternalsVisibleTo Include="Broiler.Plate.WebAssembly" />
    <InternalsVisibleTo Include="Broiler.Plate.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Documents.Docx" />
    <PackageReference Include="Broiler.Documents.Html" />
    <PackageReference Include="Broiler.Documents.Markdown" />
    <PackageReference Include="Broiler.Documents.Model" />
    <PackageReference Include="Broiler.Documents.Pagination" />
    <PackageReference Include="Broiler.Documents.Rtf" />
    <PackageReference Include="Broiler.Graphics" />
    <PackageReference Include="Broiler.Input.Keyboard" />
    <PackageReference Include="Broiler.Input.Scanner" />
    <PackageReference Include="Broiler.UI.AboutDialog" />
    <PackageReference Include="Broiler.UI.AboutDialog.Standard" />
    <PackageReference Include="Broiler.UI.Dialog.Standard" />
    <PackageReference Include="Broiler.UI.FileDialog.Standard" />
    <PackageReference Include="Broiler.UI.ImageView.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.Menu.Standard" />
    <PackageReference Include="Broiler.UI.PrintDialog.Standard" />
    <PackageReference Include="Broiler.UI.ScanDialog.Standard" />
    <PackageReference Include="Broiler.UI.RichEdit.Standard" />
    <PackageReference Include="Broiler.UI.Toolbar.Standard" />
    <PackageReference Include="Broiler.UI.Tooltip.Standard" />
    <PackageReference Include="Broiler.UI.Window.Standard" />
  </ItemGroup>

</Project>
