<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Plate</RootNamespace>
    <AssemblyName>Broiler.Plate.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The Win32 clipboard, vendored per product rather than submoduled. -->
  <ItemGroup>
    <Compile Include="..\Broiler.App\WindowsClipboard.cs" Link="WindowsClipboard.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Plate\Broiler.Plate.Core.csproj" />
    <!-- The PDF codec is referenced by the heads that register it, never by the
         shared viewer core: a head must not acquire it transitively (PDF roadmap 10.1). -->
    <ProjectReference Include="..\..\Broiler.Documents\src\Broiler.Documents.Pdf\Broiler.Documents.Pdf.csproj" />
    <!-- The image adapters. Referencing them links the decoders; composing one is a
         separate decision this head makes in Program.cs, and the difference is the
         point of the extension point. -->
    <ProjectReference Include="..\..\Broiler.Documents\src\Broiler.Documents.Pdf.Images\Broiler.Documents.Pdf.Images.csproj" />
    <ProjectReference Include="..\..\Broiler.Media\src\Broiler.Media.Image.Managed\Broiler.Media.Image.Managed.csproj" />
    <ProjectReference Include="..\..\Broiler.Graphics\src\Broiler.Graphics.Windows\Broiler.Graphics.Direct2D.csproj" />
  </ItemGroup>

  <!-- So the composition guard asserts this head's own service graph rather than
       a copy of it kept in the tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Plate.Windows.Tests" />
  </ItemGroup>

</Project>
