<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerDocumentsVersion>0.1.0-preview.28</BroilerDocumentsVersion>
    <BroilerGraphicsVersion>0.1.0-preview.14</BroilerGraphicsVersion>
    <!-- Printing: the page model is in Broiler.Graphics 0.1.0-preview.13, the backends unchanged. -->
    <BroilerGraphicsCoreVersion>0.1.0-preview.14</BroilerGraphicsCoreVersion>
    <BroilerInputVersion>0.1.0-preview.7</BroilerInputVersion>
    <BroilerHostingVersion>0.1.0-preview.10</BroilerHostingVersion>
    <BroilerMediaVersion>0.1.0-preview.16</BroilerMediaVersion>
    <BroilerUiVersion>0.1.0-preview.24</BroilerUiVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Documents.Docx" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Html" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Markdown" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Model" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Pagination" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Pdf" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Pdf.Images" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Documents.Rtf" Version="0.1.0-preview.31" />
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.17" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.17" />
    <PackageVersion Include="Broiler.Hosting.Windows" Version="0.1.0-preview.13" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Media.Image.Managed" Version="$(BroilerMediaVersion)" />
    <PackageVersion Include="Broiler.UI.AboutDialog" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.AboutDialog.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.Dialog.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.FileDialog.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.ImageView.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.Menu.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.PrintDialog.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.RichEdit.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Broiler.UI.Window.Standard" Version="0.1.0-preview.26" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>